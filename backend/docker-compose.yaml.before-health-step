version: "3.9"

services:
  mysql:
    image: mysql:8.4

    container_name: cubicles-mysql

    restart: unless-stopped

    ports:
      - "3306:3306"

    environment:
      MYSQL_ROOT_PASSWORD: root123
      MYSQL_DATABASE: cubicles_services
      MYSQL_USER: cubicles
      MYSQL_PASSWORD: Cubicles123

    volumes:
      - mysql_data:/var/lib/mysql

volumes:
  mysql_data:
