# Application
APP_NAME="Cubicles Services API"
APP_VERSION=1.0.0
ENVIRONMENT=development

# MySQL
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=cubicles_services
MYSQL_USER=cubicles
MYSQL_PASSWORD=change-this-database-password

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-64-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public application addresses
FRONTEND_PORT=8080
FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HOSTS=*

# Runtime
SQL_ECHO=false
RUN_MIGRATIONS=true
DATABASE_WAIT_TIMEOUT=90
DATABASE_WAIT_INTERVAL=2
